{
  "name": "@magpie-community/middleware-compress-core",
  "version": "0.4.0",
  "description": "magpie middleware: OmniRoute's context-compression engines, ported. 15 strategies, four presets, two panels.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manjughosa/magpie-compress-core.git"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "LICENSE",
    "NOTICE",
    "LICENSES",
    "PROVENANCE.json",
    "README.md",
    "README.en.md",
    "DEBUGGING.md",
    "adapter.js",
    "capture-store.js",
    "catalog.js",
    "compress-core.middleware.js",
    "engines",
    "hash.js",
    "lab.js",
    "observability.hooks.js",
    "options-commands.js",
    "page",
    "pipeline.js",
    "stats-writer.js",
    "telemetry-store.js"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "magpie-hooks",
    "magpie-page",
    "compression"
  ],
  "magpie": {
    "middleware": "./compress-core.middleware.js",
    "hooks": "./observability.hooks.js",
    "page": {
      "title": "Compression",
      "titles": {
        "zh": "压缩",
        "zh-TW": "壓縮",
        "ja": "圧縮"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "panels": [
      {
        "slot": "settings",
        "title": "Compression",
        "titles": {
          "zh": "压缩",
          "zh-TW": "壓縮",
          "ja": "圧縮"
        },
        "file": "page/settings.html"
      },
      {
        "slot": "usage",
        "title": "Compression",
        "titles": {
          "zh": "压缩",
          "zh-TW": "壓縮",
          "ja": "圧縮"
        },
        "file": "page/usage.html"
      }
    ],
    "options": {
      "strategies": {
        "session-dedup": false,
        "ccr": true,
        "lite": true,
        "rtk": false,
        "codex-responses": false,
        "headroom": true,
        "relevance": false,
        "caveman": false,
        "read-lifecycle": false,
        "aggressive": false,
        "llmlingua": false,
        "ultra": false,
        "ionizer": false,
        "llm": false,
        "omniglyph": false
      },
      "budgetMs": 0,
      "preserve": {
        "system": false,
        "lastTurns": 0
      },
      "gatewayTimeoutMs": 4000,
      "capture": false
    }
  },
  "scripts": {
    "build:catalog": "node scripts/gen-page-catalog.mjs",
    "build:page": "node scripts/build-lab-bundle.mjs",
    "prepack": "npm run build:catalog && npm run build:page",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
