node_modules/

# What this plugin writes on the machine it runs on, none of it belongs in the repo:
# per-request byte counts, captured requests, temp files.
requests.jsonl
*.jsonl
captures/
page/captures/
# The two files the hook republishes for the page to load: index metadata and the
# savings summary, generated on this machine, never shipped.
page/captures-index.js
page/compress-stats.js
page/compress-ccr-status.js
# Local safety nets: timestamped .bak copies and dated backup snapshots.
*.bak
*.bak.*
*.bak-*
backup/
*.tmp
*.log
.DS_Store
# 本地参考日志：各 harness 的实测存档，只留在本机，供写 skill 与研发对照。
docs/*.local.md
# 运行时数据文件（正常情况下在 ~/.config/magpie/compress-core，不在仓库；
# 万一把数据目录指到仓库，这几个也不许进版本库）。
stats.json
ccr-store.json
captures-index.json
commands.json
options-*.json
